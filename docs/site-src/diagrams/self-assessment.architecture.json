  "cards": [
    {
      "dot": "cyan",
      "title": "Entry",
      "items": [
        "Skill runs npm run assess -- $ARGUMENTS, then reports the top 3 rankedNextActions",
        "setup.md runs first when assessment.config.json is missing",
        "launchd calls run-assessment.mjs directly at 07:15"
      ]
    },
    {
      "dot": "emerald",
      "title": "Scoring",
      "items": [
        "Two axes, never collapsed: Platform Setup vs Execution",
        "Per dimension: clamp(round(raw / target × 100))",
        "main() threads data through each stage and writes app/data/ itself"
      ]
    },
    {
      "dot": "violet",
      "title": "Guarantees",
      "items": [
        "Local only; Slack needs slack.enabled + SLACK_WEBHOOK_URL",
        "Posture ratios count interactive sessions only (fail-closed)",
        "CLAUDE.md and plans audits are report-only"
      ]
    }
